server {
    listen 80;
    listen [::]:80;
    server_name singpal.io www.singpal.io;
    
    root /var/www/html/singpal.io;
    index index.html;
    
    include /etc/nginx/snippets/mosoko-translate-api.conf;
    location / {
        try_files  / =404;
    }
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}
