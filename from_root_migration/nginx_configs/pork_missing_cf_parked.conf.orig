
server {
    listen 80;
    listen [::]:80;
    server_name blckgold.com www.blckgold.com;
    root /var/www/blckgold.com;
    index index.html;
    location / { try_files $uri $uri/ /index.html; }
    add_header X-Powered-By "ZYNTHIO-VDS" always;
}

