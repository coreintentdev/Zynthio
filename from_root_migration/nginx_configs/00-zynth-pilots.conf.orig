# ZYNTHIO priority pilots — must load before pork batch confs

server {
    listen 80;
    listen [::]:80;
    server_name bytheminute.news www.bytheminute.news;
    root /var/www/bytheminute.news;
    index index.html;
    location / { try_files $uri $uri/ /index.html; }
    add_header X-Powered-By "ZYNTHIO-VDS-PILOT" always;
}

server {
    listen 80;
    listen [::]:80;
    server_name musicclothes.com www.musicclothes.com;
    root /var/www/musicclothes.com;
    index index.html;
    location / { try_files $uri $uri/ /index.html; }
    add_header X-Powered-By "ZYNTHIO-VDS-PILOT" always;
}

server {
    listen 80;
    listen [::]:80;
    server_name clearstreamchurch.com www.clearstreamchurch.com;
    root /var/www/clearstreamchurch.com;
    index index.html;
    location / { try_files $uri $uri/ /index.html; }
    add_header X-Powered-By "ZYNTHIO-VDS-PILOT" always;
}
