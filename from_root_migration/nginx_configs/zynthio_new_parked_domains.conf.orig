server {
    listen 80;
    listen [::]:80;
    server_name pica.quest www.pica.quest;
    root /var/www/pica.quest;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    add_header X-Powered-By "ZYNTHIO-VDS" always;
}



