server {
    listen 80;
    listen [::]:80;
    server_name pal.jewelry www.pal.jewelry;
    
    root /var/www/html/pal.jewelry;
    index index.html;
    
    location / {
        try_files  / =404;
    }
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}
